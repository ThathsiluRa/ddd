# Android-only control server. No Telegram token or Telegram owner ID is required.
CONTROL_API_ENABLED=true
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
# Generate a unique secret with at least 32 random characters.
CONTROL_API_TOKEN=

MAX_PAIR_PER_USER=5
SESSION_ROOT=./sessions

# Optional legacy value used only for recognizing an existing owner WhatsApp session.
OWNER_NUMBER=
